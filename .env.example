CONVEX_DEPLOYMENT=local:<generated-name>
VITE_CONVEX_URL=http://127.0.0.1:3210
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211

# Edit mode (/edit) — Convex deployment env vars (add --prod for production):
# SITE_URL=http://localhost:5173
# ALLOWED_EMAILS=you@example.com,other@example.com
# JWT_PRIVATE_KEY=...   } generate both with: node scripts/setup-auth-keys.ts --apply
# JWKS=...              }

