# ---------------------------------------------------------------------------
# Frontend (.env.local) — written for you by `npx convex dev` (local deployment)
# ---------------------------------------------------------------------------
CONVEX_DEPLOYMENT=local:<generated-name>
VITE_CONVEX_URL=http://127.0.0.1:3210
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211

# Edit mode: set the same secret on each Convex deployment, e.g.
#   npx convex env set EDIT_TOKEN <long random string>          (local)
#   npx convex env set --prod EDIT_TOKEN <long random string>   (cloud)
# then unlock edit mode in the UI with it.

# ---------------------------------------------------------------------------
# Production deploy (.env.prod.local — git-ignored, read by scripts/deploy.sh)
# ---------------------------------------------------------------------------
# CONVEX_DEPLOY_KEY=prod:<production deploy key>
# DEPLOY_HOST=pkn@37.187.139.100
# DEPLOY_PORT=20044
# DEPLOY_DIR=/var/www/dash
# LIVE_DIR=/var/www/dash-live
# SERVER_DIR=/home/pkn/dash-server
